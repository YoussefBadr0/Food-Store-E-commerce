@model FoodProject.Models.Contact
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-4 py-4">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4"><i class="bi bi-geo-alt-fill text-success"></i> Contact Us</h3>
                <p class="mb-4">
                    <strong><i class="bi bi-house-door text-success me-1"></i> Address</strong><br />
                    <span class="text-muted ms-4">BOMONTI / SISLI – ISTANBUL</span>
                </p>
                <p class="mb-4">
                    <strong><i class="bi bi-envelope text-success me-1"></i> E-Mail</strong><br />
                    <a href="mailto:foodstore@gmail.com" class="text-decoration-none ms-4">foodstore@gmail.com</a>
                </p>
                <p class="mb-0">
                    <strong><i class="bi bi-telephone text-success me-1"></i> Call Us</strong><br />
                    <span class="text-muted ms-4">(+0123) 234 567</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4"><i class="bi bi-chat-dots text-success"></i> Send a Message</h3>

                <form asp-controller="Home" asp-action="Contact" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ContactName" class="form-label">Name</label>
                            <input asp-for="ContactName" class="form-control" placeholder="Your name" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactSurname" class="form-label">Surname</label>
                            <input asp-for="ContactSurname" class="form-control" placeholder="Your surname" />
                            <span asp-validation-for="ContactSurname" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label">Email</label>
                            <input asp-for="ContactEmail" type="email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactSubject" class="form-label">Subject</label>
                            <input asp-for="ContactSubject" class="form-control" placeholder="Subject" />
                            <span asp-validation-for="ContactSubject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ContactMessage" class="form-label">Message</label>
                            <textarea asp-for="ContactMessage" class="form-control" rows="5" placeholder="Your message..."></textarea>
                            <span asp-validation-for="ContactMessage" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-send me-1"></i> Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>