@model IEnumerable<FoodProject.Models.Product>
@{
    ViewData["Title"] = "Category Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-tags text-success"></i> Filtered Products
    </h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm"><i class="bi bi-info-circle me-2"></i>No products found in this category yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductId" class="text-decoration-none">
                        <img src="~/images/Products/@item.ImageUrl"
                             alt="@item.Name"
                             class="card-img-top"
                             style="height:180px;object-fit:cover;" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">
                            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                @item.Name
                            </a>
                        </h5>

                        <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                            <span class="h5 text-success mb-0">@item.Price.ToString("N2") EGP</span>
                            <small class="text-muted">Stock: @item.Stock</small>
                        </div>

                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-success" @(item.Stock < 1 ? "disabled" : "")>
                                <i class="bi bi-cart-plus"></i> Add to Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}