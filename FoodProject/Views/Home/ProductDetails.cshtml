@model FoodProject.Models.Product
@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0 mb-5">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-5">
                <img src="~/images/Products/@Model.ImageUrl" alt="@Model.Name"
                     class="img-fluid rounded border shadow-sm" style="object-fit:cover; width:100%; max-height:420px;" />
            </div>
            <div class="col-md-7 d-flex flex-column">
                <h2 class="fw-bold mb-2">@Model.Name</h2>
                <div class="mb-3 text-warning">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-half"></i>
                </div>
                <h5 class="mt-3 fw-bold">About the Product</h5>
                <p class="text-muted">@Model.Description</p>

                <div class="d-flex align-items-center justify-content-between border-top pt-4 mt-auto">
                    <div>
                        <span class="h3 text-success fw-bold d-block mb-0">@Model.Price.ToString("N2") EGP</span>
                        <div class="small text-muted">In stock: @Model.Stock</div>
                    </div>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-success btn-lg px-4" @(Model.Stock < 1 ? "disabled" : "")>
                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>