@model FoodProject.ViewModel.SearchViewModel
@{
    ViewData["Title"] = "Search Results";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-4"><i class="bi bi-search text-success"></i> Search Results</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-semibold py-3 border-bottom">
                <i class="bi bi-basket me-1 text-success"></i> Product Matches
            </div>
            <ul class="list-group list-group-flush">
                @if (Model?.Products != null && Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductId" class="text-decoration-none text-dark fw-semibold link-success">
                                @item.Name
                            </a>
                            <span class="badge bg-success-subtle text-success p-2">@item.Price.ToString("N2") EGP</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted py-4 text-center">
                        <i class="bi bi-exclamation-circle me-1"></i> No matching products found.
                    </li>
                }
            </ul>
        </div>
    </div>
</div>