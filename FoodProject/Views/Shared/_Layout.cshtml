@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - FoodStore</title>
    <meta name="description" content="FoodStore - Fresh groceries delivered to your door" />
    <meta name="keywords" content="FoodStore, grocery, online shopping, fresh food" />
    <link rel="icon" type="image/png" href="~/Login/images/icons/e-commerce.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" type="text/css" />
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <div class="top-bar bg-dark text-white py-2 small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-telephone me-1"></i> (+20) 123 456 7890</span>
                <span class="d-none d-md-inline"><i class="bi bi-envelope me-1"></i> foodstore@@gmail.com</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="text-white">
                        <i class="bi bi-person-circle me-1"></i>
                        Welcome, @User.Identity.Name
                    </span>
                    <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-white text-decoration-none p-0 border-0">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Login" asp-action="Login" class="text-white text-decoration-none">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a asp-controller="Register" asp-action="Register" class="text-white text-decoration-none">
                        <i class="bi bi-person-plus"></i> Register
                    </a>
                }
                <a asp-controller="Home" asp-action="Contact" class="text-white text-decoration-none">
                    <i class="bi bi-chat-dots"></i> Contact Us
                </a>
            </div>
        </div>
    </div>

    <header class="bg-white border-bottom py-3">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md-3 text-center text-md-start">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <h1 class="h3 m-0 fw-bold text-success">
                            <i class="bi bi-basket2-fill"></i> Food Store
                        </h1>
                    </a>
                </div>
                <div class="col-md-6">
                    <form asp-controller="Home" asp-action="Search" method="get" class="d-flex">
                        <input type="search" name="query" class="form-control rounded-end-0" placeholder="Search for products..." />
                        <button type="submit" class="btn btn-success rounded-start-0">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
                <div class="col-md-3 text-center text-md-end">
                    <div class="d-flex justify-content-md-end justify-content-center gap-2">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success">
                            <i class="bi bi-cart3"></i> My Cart
                        </a>
                        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-primary">
                            <i class="bi bi-box-seam"></i> My Orders
                        </a>
                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-success position-relative">
                            <i class="bi bi-bell"></i>
                            <span id="notificationCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle"></i> About Us
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Products">
                            <i class="bi bi-basket"></i> Products
                        </a>
                    </li>
                    @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Statistics" asp-action="Index">
                                <i class="bi bi-bar-chart-line"></i> Admin Dashboard
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>


    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (ViewBag.ShowSidebar == true)
    {
        <main class="flex-grow-1 py-4">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3">
                        <div class="card shadow-sm">
                            <div class="card-header bg-success text-white">Categories</div>
                            <div class="card-body">
                                @await Component.InvokeAsync("CategoryList")
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </main>
    }
    else
    {
        <main class="flex-grow-1 py-4">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    }

    @await Html.PartialAsync("~/Views/Home/Footer.cshtml")

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999;">
        <div id="userToast" class="toast border-0 shadow text-white bg-success" role="alert">
            <div class="toast-header bg-success text-white border-0">
                <i class="bi bi-bell-fill me-2"></i>
                <strong class="me-auto">Notification</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body text-white" id="userToastMessage"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <button id="toTop" class="btn btn-success rounded-circle position-fixed bottom-0 end-0 m-4 d-none" style="width:45px;height:45px;z-index:1030;" aria-label="Scroll to top">
        <i class="bi bi-arrow-up"></i>
    </button>
    <script>
        (function () {
            const btn = document.getElementById('toTop');
            window.addEventListener('scroll', () => {
                btn.classList.toggle('d-none', window.scrollY < 300);
            });
            btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        })();
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNotification", function (data) {
            showUserToast(data.message);
        });

        connection.start()
            .then(() => console.log("SignalR Connected"))
            .catch(err => console.error(err));

        function showUserToast(message) {
            document.getElementById("userToastMessage").textContent = message;
            const toastElement = document.getElementById("userToast");
            const toast = new bootstrap.Toast(toastElement, { delay: 4000 });
            toast.show();
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>