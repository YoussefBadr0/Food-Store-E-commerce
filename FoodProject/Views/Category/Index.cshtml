@model List<FoodProject.Models.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-tags-fill text-success"></i> Category List</h2>
        <p class="text-muted small mb-0">Manage all product categories</p>
    </div>
    <a asp-controller="Category" asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> New Category
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Category" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-10">
                <label class="form-label small text-muted mb-1">Search by category name</label>
                <input type="text" name="p" class="form-control" placeholder="Type a category name..." />
            </div>
            <div class="col-md-2 d-grid">
                <label class="form-label small text-muted mb-1 d-none d-md-block">&nbsp;</label>
                <button type="submit" class="btn btn-outline-success">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Category Name</th>
                    <th style="width:140px;">Status</th>
                    <th style="width:120px;" class="text-center">Update</th>
                    <th style="width:120px;" class="text-center">Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-inbox"></i> No categories found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var x in Model)
                    {
                        <tr>
                            <td class="text-muted">#@x.CategoryId</td>
                            <td class="fw-semibold">@x.Name</td>
                            <td>
                                @if (x.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="bi bi-x-circle"></i> Passive
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Category" asp-action="Edit" asp-route-id="@x.CategoryId" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                            </td>
                            <td class="text-center">
                                <form asp-controller="Category" asp-action="Delete" asp-route-id="@x.CategoryId" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this category?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>