@model FoodProject.Models.Category
@{
    ViewData["Title"] = "Add Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h4 mb-1"><i class="bi bi-plus-square-fill text-success"></i> Add New Category</h2>
        <p class="text-muted small mb-0">Create a new product category</p>
    </div>
    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-controller="Category" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Beverages" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Category Description</label>
                        <textarea asp-for="Description" rows="6" class="form-control" placeholder="Short description of the category..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Save
                        </button>
                        <a asp-controller="Category" asp-action="Index" class="btn btn-light border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm bg-light border-0">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-info-circle text-success"></i> Tips</h5>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Use a short, clear category name.</li>
                    <li>The description appears on product listings.</li>
                    <li>You can edit or deactivate the category later.</li>
                </ul>
            </div>
        </div>
    </div>
</div>