@model FoodProject.ViewModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-envelope-open text-success" style="font-size:3rem;"></i>
                    <h2 class="h4 fw-bold mt-2 mb-1">Forgot Password?</h2>
                    <p class="text-muted small">Enter your email and we'll send you a reset link.</p>
                </div>

                @if (!Html.ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger small py-2" })
                }

                @using (Html.BeginForm("ForgotPassword", "Password", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-envelope me-1"></i> Email Address
                        </label>
                        @Html.TextBoxFor(x => x.Email, new { @class = "form-control form-control-lg", placeholder = "name@example.com", type = "email" })
                        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-semibold">
                            <i class="bi bi-send me-1"></i> Send Reset Link
                        </button>
                    </div>

                    <div class="text-center">
                        <a href="@Url.Action("Login", "Login")" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Back to Login
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>