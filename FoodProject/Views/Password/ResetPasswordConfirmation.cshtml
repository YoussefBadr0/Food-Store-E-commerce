@{
    ViewData["Title"] = "Password Reset Success";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <i class="bi bi-check-circle text-success" style="font-size:3.5rem;"></i>
                <h2 class="h4 fw-bold mt-3 mb-2">Password Reset!</h2>
                <p class="text-muted">
                    Your password has been reset successfully.
                    You can now log in with your new password.
                </p>
                <a href="@Url.Action("Login", "Login")" class="btn btn-success mt-2 px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login Now
                </a>
            </div>
        </div>
    </div>
</div>