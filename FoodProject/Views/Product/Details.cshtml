@model FoodProject.Models.Product
@{
    ViewData["Title"] = "Food Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-eye text-success"></i> Food Details</h2>
        <p class="text-muted mb-0">Full catalog specifications for this inventory item</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", "Product", new { id = Model.ProductId })" class="btn btn-outline-success">
            <i class="bi bi-pencil-square"></i> Edit Product
        </a>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="~/images/products/@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded w-100 border border-light" style="max-height:350px; object-fit:cover;" />
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted border border-dashed w-100" style="height:250px;">
                        <div>
                            <i class="bi bi-image d-block text-center h1 mb-1"></i>
                            <span class="small">No image uploaded</span>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-7">
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill mb-2 fw-semibold">
                    @(Model.Category?.Name ?? "Unassigned Category")
                </span>
                <h3 class="fw-bold mb-3">@Model.Name</h3>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 bg-success-subtle rounded border border-success border-opacity-10">
                            <small class="text-muted d-block uppercase fw-bold tracking-wider" style="font-size: 0.75rem;">Market Price</small>
                            <strong class="h3 text-success mb-0">$@Model.Price</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <small class="text-muted d-block uppercase fw-bold tracking-wider" style="font-size: 0.75rem;">Current Stock</small>
                            <strong class="h3 mb-0">@Model.Stock</strong>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark">Description Log</h6>
                <p class="text-muted lh-base">@(string.IsNullOrEmpty(Model.Description) ? "No contextual description provided for this catalog index yet." : Model.Description)</p>
            </div>
        </div>
    </div>
</div>