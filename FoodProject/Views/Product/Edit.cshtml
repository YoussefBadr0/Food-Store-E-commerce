@model FoodProject.Models.Product
@{
    ViewData["Title"] = "Update Food";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-pencil-square text-success"></i> Update Food</h2>
        <p class="text-muted mb-0">Edit parameters for an active product node</p>
    </div>
    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.ProductId)

                    <div class="mb-3">
                        @Html.LabelFor(x => x.Name, "Food Name", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(x => x.Stock, "Current Stock", new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(x => x.Stock, new { @class = "form-control", type = "number", min = "0" })
                            @Html.ValidationMessageFor(x => x.Stock, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(x => x.Price, "Price Point", new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                @Html.TextBoxFor(x => x.Price, new { @class = "form-control" })
                            </div>
                            @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Modify Asset Image</label>
                        <input type="file" name="Image" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2 p-2 border rounded bg-light d-inline-block">
                                <small class="text-muted d-block mb-1">Active Frame File:</small>
                                <img src="~/images/products/@Model.ImageUrl" alt="@Model.Name" class="rounded border" style="width:120px; height:90px; object-fit:cover;" />
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(x => x.CategoryId, "Category Mapping Target", new { @class = "form-label fw-semibold" })
                        @if (ViewBag.Categories != null)
                        {
                            @Html.DropDownListFor(x => x.CategoryId, (IEnumerable<SelectListItem>)ViewBag.Categories, new { @class = "form-select" })
                        }
                        else
                        {
                            @await Component.InvokeAsync("CategoryList")
                        }
                        @Html.ValidationMessageFor(x => x.CategoryId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(x => x.Description, "Description Logs", new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(x => x.Description, new { @class = "form-control", rows = 6 })
                        @Html.ValidationMessageFor(x => x.Description, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i> Update Food
                        </button>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Cancel Modification</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 bg-warning-subtle h-100">
            <div class="card-body">
                <h5 class="card-title text-warning-emphasis fw-bold"><i class="bi bi-info-circle"></i> File Operations Note</h5>
                <p class="small mb-0 text-warning-emphasis text-opacity-75">
                    Leaving the image pipeline processing selection empty retains your current active asset directory string value layout parameters. All baseline dataset shifts validate immediately upon database commit execution.
                </p>
            </div>
        </div>
    </div>
</div>