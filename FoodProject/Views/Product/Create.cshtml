@model FoodProject.ViewModel.CreateProductViewModel
@{
    ViewData["Title"] = "Add Food";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-plus-circle text-success"></i> Add New Food</h2>
        <p class="text-muted mb-0">Create a new food product in your catalog</p>
    </div>
    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        @Html.LabelFor(x => x.Name, "Food Name", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(x => x.Name, new { @class = "form-control", placeholder = "Enter food name" })
                        @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(x => x.Stock, "Stock Units", new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(x => x.Stock, new { @class = "form-control", type = "number", placeholder = "0", min = "0" })
                            @Html.ValidationMessageFor(x => x.Stock, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(x => x.Price, "Price", new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                @Html.TextBoxFor(x => x.Price, new { @class = "form-control", placeholder = "0.00" })
                            </div>
                            @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Choose Image</label>
                        <input type="file" name="Image" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(x => x.CategoryID, "Category", new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(x => x.CategoryID, (IEnumerable<SelectListItem>)ViewBag.Categories, "-- Select Category --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(x => x.CategoryID, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(x => x.Description, "Description", new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(x => x.Description, new { @class = "form-control", rows = 5, placeholder = "Describe the food item..." })
                        @Html.ValidationMessageFor(x => x.Description, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i> Save Food
                        </button>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 bg-success-subtle h-100">
            <div class="card-body">
                <h5 class="card-title text-success fw-bold"><i class="bi bi-lightbulb"></i> Quick Tips</h5>
                <ul class="small mb-0 ps-3 text-success-emphasis">
                    <li class="mb-2">Use a clear, descriptive product name.</li>
                    <li class="mb-2">Upload high-quality square images for best presentation scaling.</li>
                    <li class="mb-2">Keep pricing structures accurate and stock values up-to-date.</li>
                    <li>Assign the correct category path for optimized user discovery filters.</li>
                </ul>
            </div>
        </div>
    </div>
</div>