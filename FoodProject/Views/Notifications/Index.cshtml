@model List<FoodProject.Models.Notification>
@{
    ViewData["Title"] = "My Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-bell-fill text-success me-1"></i> My Notifications
    </h2>
    <span class="badge bg-success px-3 py-2">
        @Model.Count Notifications
    </span>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell-slash text-muted mb-3" style="font-size: 4rem;"></i>
            <h4 class="text-muted fw-normal">No notifications yet</h4>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="list-group list-group-flush">
            @foreach (var item in Model)
            {
                <a asp-controller="Notifications"
                   asp-action="Details"
                   asp-route-id="@item.NotificationId"
                   class="list-group-item list-group-item-action p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-danger p-1">New</span>
                            }
                            <span class="@(item.IsRead ? "text-secondary" : "fw-semibold text-dark")">
                                @item.Message
                            </span>
                        </div>
                        <small class="text-muted ms-3 text-nowrap">
                            @item.CreatedAt.ToString("dd MMM yyyy HH:mm")
                        </small>
                    </div>
                </a>
            }
        </div>
    </div>
}