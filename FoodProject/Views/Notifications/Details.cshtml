@model FoodProject.Models.Notification
@{
    ViewData["Title"] = "Notification Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-bell me-2"></i>Notification
                </h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    <i class="bi bi-clock me-1"></i>
                    @Model.CreatedAt.ToString("dddd, dd MMMM yyyy HH:mm")
                </p>
                <hr class="text-muted opacity-25" />
                <h5 class="fw-normal lh-base my-4">
                    @Model.Message
                </h5>

                @if (!string.IsNullOrEmpty(Model.Url))
                {
                    <div class="mt-4 pt-2">
                        <a href="@Model.Url" class="btn btn-success">
                            <i class="bi bi-arrow-right-circle me-1"></i> Open Related Page
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>