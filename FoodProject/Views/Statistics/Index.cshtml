@using FoodProject.Enums
@model FoodProject.ViewModel.StatisticsViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-4"><i class="bi bi-speedometer2 text-success"></i> Dashboard</h2>

@* ===== CARDS ===== *@
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle bg-success-subtle p-3">
                    <i class="bi bi-bag-check text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Orders</div>
                    <div class="fw-bold h4 mb-0">@Model.TotalOrders</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle bg-primary-subtle p-3">
                    <i class="bi bi-currency-dollar text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Revenue</div>
                    <div class="fw-bold h4 mb-0">@Model.TotalRevenue.ToString("N2") EGP</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle bg-warning-subtle p-3">
                    <i class="bi bi-box-seam text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Products</div>
                    <div class="fw-bold h4 mb-0">@Model.TotalProducts</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle bg-info-subtle p-3">
                    <i class="bi bi-people text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Users</div>
                    <div class="fw-bold h4 mb-0">@Model.TotalUsers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    @* ===== MONTHLY REVENUE CHART ===== *@
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Monthly Revenue (Last 6 Months)</h5>
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>

    @* ===== ORDERS BY STATUS ===== *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Orders by Status</h5>
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* ===== RECENT ORDERS ===== *@
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Orders</h5>
                    <a asp-action="Index" asp-controller="AdminOrder" class="btn btn-sm btn-outline-success">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-semibold">#@order.OrderId</td>
                                    <td>@order.AppUser?.UserName</td>
                                    <td class="text-success fw-semibold">@order.TotalAmount.ToString("N2") EGP</td>
                                    <td>
                                        @{
                                            var badge = order.Status switch
                                            {
                                                OrderStatus.Pending => "bg-warning text-dark",
                                                OrderStatus.Processing => "bg-info text-dark",
                                                OrderStatus.Shipped => "bg-primary",
                                                OrderStatus.Delivered => "bg-success",
                                                OrderStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badge">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ===== TOP PRODUCTS ===== *@
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Top Selling Products</h5>
                @{
                    // Fixed runtime crash condition when system has 0 products
                    var max = Model.TopProducts != null && Model.TopProducts.Any() ? Model.TopProducts.Max(x => x.TotalSold) : 0;
                }

                @if (Model.TopProducts != null && Model.TopProducts.Any())
                {
                    @foreach (var product in Model.TopProducts)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@product.ProductName</span>
                                <span class="text-muted">@product.TotalSold sold</span>
                            </div>
                            <div class="progress" style="height:8px;">
                                @{
                                    var percent = max > 0 ? (product.TotalSold * 100 / max) : 0;
                                }
                                <div class="progress-bar bg-success" style="width:@percent%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small my-3">No sales tracking data available yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===== Revenue Chart =====
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.MonthlyRevenue.Select(x => $"'{x.Month}'")))],
                datasets: [{
                    label: 'Revenue (EGP)',
                    data: [@string.Join(",", Model.MonthlyRevenue.Select(x => x.Revenue))],
                    backgroundColor: 'rgba(45, 106, 79, 0.7)',
                    borderRadius: 6
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        // ===== Status Chart =====
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.OrdersByStatus.Keys.Select(x => $"'{x}'")))],
                datasets: [{
                    data: [@string.Join(",", Model.OrdersByStatus.Values)],
                    backgroundColor: ['#ffc107','#0dcaf0','#0d6efd','#198754','#dc3545']
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });
    </script>
}