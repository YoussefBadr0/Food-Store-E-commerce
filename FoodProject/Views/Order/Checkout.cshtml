@model FoodProject.ViewModel.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-4"><i class="bi bi-credit-card text-success me-1"></i> Checkout</h2>

<form asp-controller="Order" asp-action="Checkout" method="post">
    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4"><i class="bi bi-truck me-2 text-success"></i>Shipping Information</h5>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="+20 123 456 7890" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="City" class="form-label fw-semibold">City</label>
                        <input asp-for="City" class="form-control" placeholder="Enter your city" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label fw-semibold">Shipping Address</label>
                        <textarea asp-for="ShippingAddress" rows="3" class="form-control" placeholder="Enter your full street address"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-bag me-2 text-success"></i>Order Summary</h5>

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <img src="~/images/products/@item.Product.ImageUrl"
                                     alt="@item.Product.Name"
                                     style="width:45px;height:45px;object-fit:cover;"
                                     class="rounded" />
                                <div>
                                    <div class="small fw-semibold">@item.Product.Name</div>
                                    <div class="small text-muted">x@item.Quantity</div>
                                </div>
                            </div>
                            <span class="fw-semibold text-dark">@((item.Product.Price * item.Quantity).ToString("N2")) EGP</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-3 fw-bold h5">
                        <span>Total</span>
                        <span class="text-success">@Model.TotalAmount.ToString("N2") EGP</span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-check-circle me-1"></i> Place Order
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                        <i class="bi bi-arrow-left me-1"></i> Back to Cart
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>