@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-lg-6 col-md-8 text-center">
        <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
        <h1 class="display-1 fw-bold mt-4 mb-2">403</h1>
        <h2 class="h3 fw-semibold mb-3">Access Denied</h2>
        <p class="text-muted mb-4">
            You do not have permission to view this page. Please contact the administrator if you believe this is an error.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg fw-semibold">
            <i class="bi bi-house-door me-1"></i> Back to Home
        </a>
    </div>
</div>